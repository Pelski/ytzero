---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const docs = await getCollection("docs");
const entry = docs.find((doc) => doc.id === "Home");
if (!entry) throw new Error("wiki/Home.md is required for the documentation landing page.");
const { Content, headings } = await render(entry);
---

<DocsLayout currentSlug="Home" headings={headings}>
  <Content />
</DocsLayout>
