---
import BaseLayout from "../layouts/BaseLayout.astro";
import { path } from "../lib/paths";
---

<BaseLayout title="Not found — YT Zero">
  <section class="not-found dark-section">
    <div class="shell">
      <p class="eyebrow"><span></span> 404</p>
      <h1>Nothing queued here.</h1>
      <p>This page may have moved, or perhaps it was sensibly archived.</p>
      <a class="button primary" href={path("/")}>Return home</a>
    </div>
  </section>
</BaseLayout>
