{
  "name": "ytzero",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "setup": "bash ./scripts/setup.sh",
    "dev": "bash ./scripts/dev.sh",
    "dev:app": "cd app && bun run dev",
    "dev:ui": "cd ui && bun run dev",
    "build": "bash ./scripts/build.sh",
    "build:ui": "cd ui && bun run build:prepared",
    "check:large-files": "bun scripts/check-large-files.ts",
    "test": "bun run test:app && bun run test:ui",
    "test:app": "cd app && bun run test",
    "test:ui": "cd ui && bun run test",
    "typecheck": "bun run typecheck:app && bun run typecheck:ui",
    "typecheck:app": "cd app && bun run typecheck",
    "typecheck:ui": "cd ui && bun run typecheck",
    "check": "bun run check:large-files && bun run typecheck && bun run test && bun run build:ui",
    "start": "bash ./scripts/start.sh"
  }
}
